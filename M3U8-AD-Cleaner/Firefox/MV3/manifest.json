{
  "manifest_version": 3,
  "name": "M3U8 AD Cleaner",
  "version": "1.1.1",
  "description": "拦截和过滤 m3u8 切片广告，支持导出无广告播放列表",
  "author": "Shay",
  "license": "MIT",

  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      },
      "id": "m3u8-ad-cleaner@dxdragon.ga",
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "storage",
    "tabs",
    "downloads",
    "webNavigation"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": ["filter.js", "background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "action": {
    "default_title": "M3U8 AD Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-on-16.png",
      "32": "icons/icon-on-32.png",
      "48": "icons/icon-on-48.png",
      "96": "icons/icon-on-96.png",
      "128": "icons/icon-on-128.png"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon-on-16.png",
    "32": "icons/icon-on-32.png",
    "48": "icons/icon-on-48.png",
    "96": "icons/icon-on-96.png",
    "128": "icons/icon-on-128.png"
  }
}