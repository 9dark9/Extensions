{
  "manifest_version": 3,
  "name": "M3U8 AD Cleaner",
  "version": "1.1.1",
  "description": "拦截和过滤 m3u8 切片广告，支持导出无广告播放列表",
  "author": "Shay",

  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["filter.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],

  "action": {
    "default_title": "M3U8 AD Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-on-16.png",
      "32": "icons/icon-on-32.png",
      "48": "icons/icon-on-48.png",
      "96": "icons/icon-on-96.png",
      "128": "icons/icon-on-128.png"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon-on-16.png",
    "32": "icons/icon-on-32.png",
    "48": "icons/icon-on-48.png",
    "96": "icons/icon-on-96.png",
    "128": "icons/icon-on-128.png"
  }
}